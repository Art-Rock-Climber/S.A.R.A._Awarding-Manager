<Window x:Class="sara_coursework.Views.EditAwardedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sara_coursework"
        mc:Ignorable="d"
        Title="Редактирование награждаемого" Height="370" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ComboBox x:Name="cmbType" Grid.Row="0" SelectedIndex="0" SelectionChanged="cmbType_SelectionChanged">
            <ComboBoxItem>Гражданин</ComboBoxItem>
            <ComboBoxItem>Коллектив</ComboBoxItem>
        </ComboBox>

        <!-- Для гражданина -->
        <StackPanel x:Name="spCitizen" Grid.Row="1">
            <Label Content="Фамилия*"/>
            <TextBox x:Name="txtLastName" Margin="0,0,0,5"/>

            <Label Content="Имя*"/>
            <TextBox x:Name="txtFirstName" Margin="0,0,0,5"/>

            <Label Content="Отчество"/>
            <TextBox x:Name="txtMiddleName" Margin="0,0,0,5"/>

            <Label Content="Должность*"/>
            <TextBox x:Name="txtPosition" Margin="0,0,0,5"/>

            <Label Content="Коллектив"/>
            <ComboBox x:Name="cmbCollective" Margin="0,0,0,5" 
                      DisplayMemberPath="CollectiveName"
                      SelectedValuePath="Id"/>
        </StackPanel>

        <!-- Для коллектива -->
        <StackPanel x:Name="spCollective" Grid.Row="2" Visibility="Collapsed">
            <Label Content="Название коллектива*"/>
            <TextBox x:Name="txtCollectiveName" Margin="0,0,0,5"/>

            <Label Content="Участники"/>
            <ListBox x:Name="lstMembers" Margin="0,0,0,5" 
                     SelectionMode="Multiple"
                     DisplayMemberPath="DisplayName"
                     Height="100"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="SaveButton_Click" IsDefault="True"/>
            <Button Content="Отмена" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
