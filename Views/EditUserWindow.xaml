<Window x:Class="sara_coursework.Views.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sara_coursework.Views"
        mc:Ignorable="d"
        Title="Пользователь" Height="350" Width="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Логин -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Логин пользователя*"/>
            <TextBox x:Name="txtUsername" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
        </StackPanel>

        <!-- Пароль -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Label x:Name="lblPassword" Content="Пароль*"/>
            <PasswordBox x:Name="txtPassword" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
        </StackPanel>

        <!-- Подтверждение пароля -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <Label x:Name="lblConfirmPassword" Content="Подтверждение пароля*"/>
            <PasswordBox x:Name="txtConfirmPassword" Height="26" VerticalContentAlignment="Center" Padding="4,0"/>
        </StackPanel>

        <!-- Роль -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <Label Content="Роль в системе*"/>
            <ComboBox x:Name="cmbRole" Height="26" VerticalContentAlignment="Center">
                <ComboBoxItem Content="Администратор (Admin)" Tag="Admin"/>
                <ComboBoxItem Content="Обычный пользователь (User)" Tag="User"/>
                <ComboBoxItem Content="Только чтение (ReadOnly)" Tag="ReadOnly"/>
            </ComboBox>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" IsDefault="True"/>
            <Button Content="Отмена" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
