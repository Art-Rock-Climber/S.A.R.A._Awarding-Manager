<Window x:Class="sara_coursework.Views.EditSingleAwardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sara_coursework"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Редактирование награждения" Height="350" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Постановление -->
        <GroupBox Grid.Row="0" Header="Постановление*">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="cmbDecree" DisplayMemberPath="DisplayText"
                          SelectedValuePath="Id" Grid.Column="0"/>
                <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="30" Margin="5,0,0,0" Grid.Column="1" Click="AddDecree_Click" ToolTip="Добавить постановление..."/>
            </Grid>
        </GroupBox>

        <!-- Награда -->
        <GroupBox Grid.Row="1" Header="Награда*" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="cmbAward" DisplayMemberPath="AwardName"
                          SelectedValuePath="Id" Grid.Column="0"/>
                <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="30" Margin="5,0,0,0" Grid.Column="1" Click="AddAward_Click" ToolTip="Добавить награду..."/>
            </Grid>
        </GroupBox>

        <!-- Награждаемый -->
        <GroupBox Grid.Row="2" Header="Награждаемый*" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="cmbAwarded" DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id" Grid.Column="0"/>
                <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="30" Margin="5,0,0,0" Grid.Column="1" Click="AddAwarded_Click" ToolTip="Добавить награждаемого..."/>
            </Grid>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="SaveButton_Click" IsDefault="True"/>
            <Button Content="Отмена" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
