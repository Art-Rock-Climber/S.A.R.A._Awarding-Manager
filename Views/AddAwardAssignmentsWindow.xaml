<Window x:Class="sara_coursework.Views.AddAwardAssignmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sara_coursework"
        mc:Ignorable="d"
        Title="Добавление награждений" Height="420" Width="440" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Постановление -->
            <RowDefinition Height="Auto"/> <!-- Награда -->
            <RowDefinition Height="Auto"/> <!-- Заголовок списка -->
            <RowDefinition Height="Auto"/> <!-- Поиск награждаемых -->
            <RowDefinition Height="Auto"/> <!-- Счетчик -->
            <RowDefinition Height="*"/> <!-- Список награждаемых -->
            <RowDefinition Height="Auto"/> <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- Постановление -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Постановление*"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="cmbDecree" DisplayMemberPath="DisplayText"
                          IsEditable="True" IsTextSearchEnabled="True"
                          HorizontalAlignment="Stretch" SelectedValuePath="Id" Grid.Column="0"/>
                <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="28" Margin="5,0,0,0" Grid.Column="1" Click="AddDecree_Click" ToolTip="Добавить постановление..."/>
            </Grid>
        </StackPanel>

        <!-- Награда -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Label Content="Награда*"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="cmbAward" DisplayMemberPath="AwardName"
                          IsEditable="True" IsTextSearchEnabled="True"
                          HorizontalAlignment="Stretch" SelectedValuePath="Id" Grid.Column="0"/>
                <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="28" Margin="5,0,0,0" Grid.Column="1" Click="AddAward_Click" ToolTip="Добавить награду..."/>
            </Grid>
        </StackPanel>

        <!-- Заголовок списка -->
        <Grid Grid.Row="2" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="Награждаемые*" Grid.Column="0" VerticalAlignment="Center" Padding="0"/>
            <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Height="20" Width="28" Margin="5,0,0,0" Grid.Column="1" Click="AddAwarded_Click" ToolTip="Добавить награждаемого..."/>
        </Grid>

        <!-- Поиск награждаемых -->
        <Grid Grid.Row="3" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtSearchAwarded" Grid.Column="0" 
                     TextChanged="TxtSearchAwarded_TextChanged" VerticalContentAlignment="Center"/>
            <Button x:Name="btnClearSearchAwarded" Grid.Column="1"
                    Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                    Width="28" Margin="5,0,0,0"
                    Click="ClearSearchAwarded_Click" ToolTip="Очистить поиск"/>
        </Grid>

        <!-- Счетчик -->
        <TextBlock Grid.Row="4" x:Name="tbSelectedCount" Text="Выбрано: 0" Margin="0,0,0,5"
                   FontStyle="Italic" Foreground="Gray"/>

        <!-- Список награждаемых -->
        <ListBox Grid.Row="5" x:Name="lbAwarded" 
                 SelectionMode="Multiple" DisplayMemberPath="DisplayName"
                 SelectedValuePath="Id"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionChanged="LbAwarded_SelectionChanged"
                 Margin="0,0,0,10"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="SaveButton_Click" IsDefault="True" Width="90" Margin="0,0,5,0"/>
            <Button Content="Отмена" Click="CancelButton_Click" IsCancel="True" Width="90"/>
        </StackPanel>
    </Grid>
</Window>
