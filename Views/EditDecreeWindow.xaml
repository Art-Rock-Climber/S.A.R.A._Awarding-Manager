<Window x:Class="sara_coursework.Views.EditDecreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sara_coursework"
        mc:Ignorable="d"
        Title="Редактирование постановления" Height="250" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Номер постановления*" Grid.Row="0"/>
        <TextBox x:Name="txtNumber" Grid.Row="1" Margin="0,0,0,5"/>

        <Label Content="Дата*" Grid.Row="2"/>
        <DatePicker x:Name="dpDate" Grid.Row="3" Margin="0,0,0,5"/>

        <Label Content="Основание награждения*" Grid.Row="4"/>
        <ComboBox x:Name="cmbReason" Grid.Row="5" DisplayMemberPath="ReasonName" Margin="0,0,0,5"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Click="Save_Click" IsDefault="True"/>
            <Button Content="Отмена" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
