<Window x:Class="sara_coursework.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sara_coursework.Views"
        mc:Ignorable="d"
        Title="Регистрация" Height="270" Width="350">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Логин:" Grid.Row="0"/>
        <TextBox x:Name="txtUsername" Grid.Row="1" Margin="0,5"/>

        <TextBlock Text="Пароль:" Grid.Row="2" Margin="0,10,0,0"/>
        <PasswordBox x:Name="txtPassword" Grid.Row="3" Margin="0,5"/>

        <TextBlock Text="Подтверждение пароля:" Grid.Row="4" Margin="0,10,0,0"/>
        <PasswordBox x:Name="txtConfirmPassword" Grid.Row="5" Margin="0,5"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Зарегистрироваться" Click="RegisterButton_Click" IsDefault="True"/>
            <Button Content="Отмена" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
